# 编译产物
/dist/
/szunet
/szunet.exe
*.exe
*.test
*.out

# 本地配置：里面可能有账号信息，绝对不要提交
.szunet/
config.json
credentials.json
.env

# 编辑器 / 系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 页面资源的生成副本：desktop/index.html 是唯一界面源文件。
# build-windows.py 会先生成 desktop/assets/index.html，再复制整个 assets/
# 到 desktop/internal/ui/assets 供 go:embed 使用。
desktop/assets/index.html
desktop/internal/ui/assets/

# 渲染自检的中间产物
desktop/design/_measure.html
desktop/design/_slice*.html
desktop/*.measure.html
# 临时调试页面（探针脚本会现场生成、跑完删掉）
desktop/_*.html
desktop/assets/_*.html
desktop/design/_*.html
desktop/design/_*.png

# 协议分析用的第三方参考源码（只留本地，绝不进库）
design/vpn-ref-*.go.txt

# 排查协议的临时脚本/抓下来的页面（探完了就可以删，不需要进库）
.scratch_probe/
.portal_js.txt

# 临时打包产物
/outputs/

# 内部规划 / 设计稿：只留本地，不进公开仓库
# （这类文档会写服务器地址、账号、内网拓扑，公开出去是事故）
.local-docs/
